  {
    "id": "pat-static-site",
    "name": "静的サイト/LP/ドキュメントの公開",
    "goal": "サーバー処理が不要な、ファイル配信中心のサイトを公開する",
    "recommendedStack": [
      "s3",
      "cloudfront",
      "route53",
      "acm"
    ],
    "stackRoles": [
      {
        "serviceId": "s3",
        "role": "静的ファイルの配信元（オリジン）"
      },
      {
        "serviceId": "cloudfront",
        "role": "CDN・HTTPS 配信"
      },
      {
        "serviceId": "route53",
        "role": "DNS（ドメイン名の解決）"
      },
      {
        "serviceId": "acm",
        "role": "TLS 証明書（HTTPS 用）"
      }
    ],
    "rationale": "常時稼働サーバーを持たず、配信は CDN に任せる。OS パッチや監視の負担が小さい。",
    "antiPatterns": [
