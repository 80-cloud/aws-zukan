  {
    "id": "pat-ec2-deploy",
    "name": "EC2 への自動デプロイ（手元ビルド→ECR→pull）",
    "goal": "terraform apply 1 発に近い形で、EC2 へアプリを自動デプロイする",
    "recommendedStack": [
      "ec2",
      "ecr",
      "iam"
    ],
    "stackRoles": [
      {
        "serviceId": "ec2",
        "role": "アプリ実行（イメージを pull）"
      },
      {
        "serviceId": "ecr",
        "role": "コンテナイメージの保管"
      },
      {
        "serviceId": "iam",
        "role": "EC2 が ECR から pull する権限"
      }
    ],
    "rationale": "重いビルドは手元でやり、ECR に push。EC2 は起動時に IAM ロールの一時資格で ECR から pull して動かすだけにする。",
    "antiPatterns": [
      {
        "stack": [
          "ec2"
        ],
        "why": "EC2 の中でビルドすると、小さいインスタンスでメモリ不足になりやすい。",
        "source": "https://qiita.com/80-cloud/items/9e5688260032e85098e8"
      },
      {
        "stack": [
          "iam"
        ],
        "why": "ECR pull 用のアクセスキーを user_data に直書きするのは危険。長期キーを機械に置かない。",
        "source": "https://qiita.com/80-cloud/items/9e5688260032e85098e8"
      }
    ],
    "requiredGovernance": [
      "EC2 には IAM ロールで一時資格を配る",
      "イメージは EC2 のアーキ(amd64)で焼く",
      "アクセスキーを直書きしない"
    ],
    "optional": [
      "Docker Compose で DB 同居",
      "CI からの push 自動化"
    ],
    "suitableConditions": [
      "コンテナ化済みのアプリ",
      "勉強用/小規模の自動デプロイ"
    ],
    "alternatives": [
      "ECS/Fargate",
      "Ec2 上で都度ビルド(非推奨)"
    ],
    "notes": "コンテナ内の localhost は別コンテナの DB に届かない。compose のサービス名(db 等)を宛先にする。",
    "difficulty": 3,
    "evaluation": {
      "security": "○",
      "availability": "○",
      "opsLoad": "○",
      "cost": "○",
      "scalability": "△",
      "governanceFit": "○",
      "migrationEase": "○",
      "vendorLockin": "△"
    },
    "scenarioTags": [
      "勉強用デプロイ",
      "オンプレ移行"
    ],
    "realWorldNotes": [
      {
        "source": "https://qiita.com/80-cloud/items/9e5688260032e85098e8",
        "gotcha": "一周目に手作業で踏んだ罠(arm64/amd64・localhost・鍵)を、二周目は user_data の自動化で先回りして全部避けた。"
      }
    ]
