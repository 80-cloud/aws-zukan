      "availability": "○",
      "opsLoad": "○",
      "cost": "◎",
      "scalability": "○",
      "governanceFit": "○",
      "migrationEase": "○",
      "vendorLockin": "△"
    },
    "scenarioTags": [
      "チーム開発基盤",
      "IaC 導入"
    ],
    "realWorldNotes": [
      {
        "source": "https://qiita.com/80-cloud/items/0a0088ccff70d536c2d4",
        "gotcha": "bootstrap はローカル state のまま置き場(S3)だけ作り、その後に本体へ backend を書いてリモート state へ移行する。"
      }
    ]
