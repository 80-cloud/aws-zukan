  {
    "id": "pat-alb-frontend",
    "name": "ALB で EC2 アプリを公開",
    "goal": "VPC 内の EC2 アプリ(Spring Boot 等)をインターネットに公開する",
    "recommendedStack": [
      "alb",
      "ec2",
      "vpc",
      "securitygroup"
    ],
    "rationale": "ALB を前段に置き HTTPS 終端と複数 AZ 分散を担う。EC2 への直接 SSH は開けず、ALB の SG からのみアプリポートを許可する。",
    "antiPatterns": [
      {
        "stack": [
          "alb"
        ],
        "why": "public サブネットが 1 AZ にしかないと、インターネット向け ALB の「2 AZ に public サブネット」要件を満たせず作成できない。",
        "source": "https://qiita.com/80-cloud/items/f094039371ebe1bea1a5"
      },
      {
        "stack": [
          "ec2",
          "securitygroup"
        ],
        "why": "SSH(22) を 0.0.0.0/0 で開けるのは総当たりの標的になる。ALB 経由なら SSH は不要で開けない。",
        "source": "https://qiita.com/80-cloud/items/f8f04de4a9206f8ffa95"
      }
    ],
    "requiredGovernance": [
      "2 AZ に public サブネット",
      "ALB で HTTPS 終端",
      "アプリポートは ALB の SG からのみ許可",
      "SSH は開けない/絞る"
    ],
    "optional": [
      "WAF",
      "アクセスログ",
      "Auto Scaling"
    ],
    "suitableConditions": [
      "常時稼働する動的アプリ",
      "VPC 内に EC2 がある"
    ],
    "alternatives": [
      "CloudFront + S3(静的のみ)",
      "ECS/Fargate + ALB"
    ],
    "notes": "鍵名の直書きは避け、パラメータ化する（環境を選ばなくなる）。",
    "difficulty": 3,
    "evaluation": {
      "security": "○",
      "availability": "◎",
      "opsLoad": "△",
      "cost": "○",
      "scalability": "○",
      "governanceFit": "○",
      "migrationEase": "○",
      "vendorLockin": "△"
    },
    "scenarioTags": [
      "外部公開アプリ",
      "オンプレ移行"
    ],
    "stackRoles": [
      {
        "serviceId": "alb",
        "role": "ロードバランサ・HTTPS 終端"
      },
      {
        "serviceId": "ec2",
        "role": "アプリ実行"
      },
      {
        "serviceId": "vpc",
        "role": "ネットワーク（public/private）"
      },
      {
        "serviceId": "securitygroup",
        "role": "通信制御（ALB→EC2）"
      }
    ],
    "realWorldNotes": [
      {
        "source": "https://qiita.com/80-cloud/items/f094039371ebe1bea1a5",
        "gotcha": "「サブネットを作ってある」と「2 AZ に public サブネットがある」は別物。2 つ目の AZ に public サブネット(IGW 経路つき)を足して解決した。"
      }
    ]
