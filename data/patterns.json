  {
    "id": "pat-rds-access",
    "name": "RDS への安全な接続",
    "goal": "アプリの DB(RDS)を、外から触れないように隔離しつつ EC2 から使う",
    "recommendedStack": [
      "rds",
      "ec2",
      "vpc",
      "securitygroup"
    ],
    "stackRoles": [
      {
        "serviceId": "rds",
        "role": "データベース（private に隔離）"
      },
      {
        "serviceId": "ec2",
        "role": "アプリ実行（DB に接続）"
      },
      {
        "serviceId": "vpc",
        "role": "ネットワーク（public/private 分離）"
      },
      {
        "serviceId": "securitygroup",
        "role": "通信制御（EC2→RDS のみ許可）"
      }
    ],
    "rationale": "RDS を private サブネットに「パブリックアクセスなし」で置き、許可元を EC2 の SG にする。DB へは VPC 内の EC2 を経由して接続する。",
    "antiPatterns": [
      {
        "stack": [
          "rds"
        ],
        "why": "パブリックアクセスを有効にして外から直結できるようにすると、攻撃面が広がる。隔離の利点を失う。",
        "source": "https://qiita.com/80-cloud/items/6e97c7e8f2076c78ea06"
      }
    ],
    "requiredGovernance": [
      "private サブネット配置",
      "パブリックアクセスなし",
      "許可元は EC2 の SG",
      "DB ポート(5432/3306)のみ許可"
    ],
    "optional": [
      "自動バックアップ",
      "マルチ AZ"
    ],
    "suitableConditions": [
      "アプリが VPC 内の EC2 で動く"
    ],
    "alternatives": [
      "踏み台/Session Manager 経由の運用接続"
    ],
    "notes": "手元の Mac から直結できない(タイムアウト)のは正常。隔離が効いているサイン。",
    "difficulty": 2,
    "evaluation": {
      "security": "◎",
      "availability": "○",
      "opsLoad": "○",
      "cost": "○",
      "scalability": "○",
      "governanceFit": "◎",
      "migrationEase": "○",
      "vendorLockin": "△"
    },
    "scenarioTags": [
